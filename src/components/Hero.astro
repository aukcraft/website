---
import FlightLine from './FlightLine.astro';
---

<header class="mx-auto flex max-w-5xl items-baseline justify-between px-6 pt-10">
  <a href="/" class="font-mono text-sm tracking-tight text-ink">aukcraft</a>
  <a
    class="link-line font-mono text-xs"
    href="https://github.com/aukcraft"
    target="_blank"
    rel="noopener noreferrer">github.com/aukcraft</a
  >
</header>

<section class="mx-auto max-w-5xl px-6 pb-40 pt-32 md:pt-44">
  <h1 class="sr-only">aukcraft</h1>

  <p class="text-5xl font-medium leading-tight tracking-tight md:text-7xl" data-reveal>
    Craft the <em class="font-serif italic">architecture</em>.
  </p>
  <p class="serif-zh mt-4 text-xl text-muted md:text-2xl" data-reveal>
    架构即工艺。
  </p>

  <p class="mt-12 max-w-prose text-lg leading-relaxed md:text-xl" data-reveal>
    A small open-source team building modular, reusable infrastructure —
    with a deliberately lightweight stack.
  </p>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted" data-reveal>
    一个小而精的开源团队，以模块化思维构建可复用的基础设施——配以刻意轻量的技术栈。
  </p>

  <div class="mt-14 flex flex-wrap gap-4" data-reveal>
    <a
      href="https://github.com/aukcraft"
      target="_blank"
      rel="noopener noreferrer"
      class="flight inline-flex items-center border border-hairline px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-ink"
    >
      View GitHub
      <FlightLine />
    </a>
    <a
      href="https://peregrine.aukcraft.org/"
      target="_blank"
      rel="noopener noreferrer"
      class="flight inline-flex items-center border border-hairline px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-teal"
    >
      Explore Peregrine
      <FlightLine />
    </a>
  </div>
</section>
