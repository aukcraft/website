---
import SectionHeading from './SectionHeading.astro';

const stack = [
  ['Language', 'Rust', 'systems programming, performance, safety'],
  ['Desktop', 'Tauri 2.x', 'lightweight cross-platform desktop runtime'],
  ['Frontend', 'React + TypeScript', 'precise, typed UI engineering'],
  ['Styling', 'Tailwind CSS', 'constrained, consistent design tokens'],
  ['Scripting', 'Rhai', 'user-facing programmability, embedded in Rust'],
];
---

<section id="technology" class="mx-auto max-w-5xl px-6 py-40 md:py-56">
  <SectionHeading index="03" label="TECHNOLOGY" />

  <div class="mt-16 border border-hairline bg-raised" data-reveal>
    <p class="border-b border-hairline px-6 py-3 font-mono text-xs text-muted">
      $ aukcraft --stack
    </p>
    <dl class="px-6 py-6">
      {
        stack.map(([layer, tool, note]) => (
          <div class="grid grid-cols-1 gap-1 py-2 font-mono text-sm leading-relaxed sm:grid-cols-[8rem_20ch_1fr] sm:gap-4">
            <dt class="text-muted">{layer}</dt>
            <dd class="text-ink">{tool}</dd>
            <dd class="text-muted">— {note}</dd>
          </div>
        ))
      }
    </dl>
  </div>

  <p class="mt-12 max-w-prose text-lg leading-relaxed md:text-xl" data-reveal>
    We're not a Rust shop. Rust just keeps winning the evaluation.
  </p>
  <p class="mt-3 max-w-prose text-sm leading-relaxed text-muted" data-reveal>
    我们不是 Rust 团队——Rust 只是每次评估都胜出。
  </p>
</section>
