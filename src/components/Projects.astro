---
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const tags = ['Rust', 'Tauri 2.x', 'React', 'TypeScript', 'Tailwind CSS', 'Rhai'];

const highlights = zh
  ? [
      '四层可编程架构——Elements → Materials（Rhai 脚本）→ Layers → Profiles。',
      '热重载配置——外部编辑即时生效；原子写入，永不损坏。',
      '用户可编程——放入 .rhai material 脚本，自动生成交互式 UI。',
      '高性能覆盖层——透明、置顶，跟随目标窗口。',
    ]
  : [
      'Four-layer programmable architecture — Elements → Materials (Rhai scripts) → Layers → Profiles.',
      'Hot-reloadable configuration — external edits take effect instantly; atomic writes never corrupt.',
      'User-programmable — drop-in .rhai material scripts with auto-generated interactive UI.',
      'High-performance overlay — transparent, always-on-top, follows target windows.',
    ];

const t = {
  meta: zh
    ? 'MIT · Windows (x86 / x64 / ARM64) · macOS 与 Linux 计划中'
    : 'MIT · Windows (x86 / x64 / ARM64) · macOS & Linux planned',
  body: zh
    ? '可编程的桌面视觉覆盖层系统——最初为解决 3D 眩晕而生，核心是通用的视觉锚点引擎。'
    : 'A programmable desktop visual overlay system — originally built to solve 3D motion sickness, at its core a general-purpose visual anchor engine.',
  site: zh ? '项目网站' : 'Project Site',
  source: zh ? '源代码' : 'Source',
  nextLabel: zh ? '接下来' : 'NEXT',
  nextTitle: zh ? '更多 crate 在路上' : 'More crates on the way',
  nextBody: zh
    ? '经过实战检验的内部模块，逐一提炼并开源。'
    : 'Battle-tested internal modules, extracted and open-sourced one by one.',
};
---

<section id="projects" class="mx-auto max-w-5xl px-6 py-40 md:py-56">
  <SectionHeading index="02" label={zh ? '项目' : 'PROJECTS'} />

  <div class="mt-16 grid gap-6 lg:grid-cols-3">
    <article class="border border-hairline bg-raised p-8 md:p-10 lg:col-span-2" data-reveal>
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h3 class="text-2xl font-medium tracking-tight">Peregrine</h3>
        <p class="micro text-xs text-muted">{t.meta}</p>
      </div>

      <p class="mt-6 max-w-prose leading-relaxed">
        {t.body}
      </p>

      <ul class="mt-8 space-y-3">
        {
          highlights.map((h) => (
            <li class="max-w-prose text-sm leading-relaxed">
              <span class="text-muted">—&thinsp;</span>
              {h}
            </li>
          ))
        }
      </ul>

      <ul class="mt-8 flex flex-wrap gap-2">
        {
          tags.map((tag) => (
            <li class="border border-hairline px-2.5 py-1 font-mono text-xs text-muted">{tag}</li>
          ))
        }
      </ul>

      <div class="mt-10 flex flex-wrap gap-8">
        <a
          class="link-line font-mono text-xs uppercase tracking-[0.15em]"
          href="https://peregrine.aukcraft.org/"
          target="_blank"
          rel="noopener noreferrer">{t.site}&thinsp;↗</a
        >
        <a
          class="link-line font-mono text-xs uppercase tracking-[0.15em]"
          href="https://github.com/eeymoo/peregrine"
          target="_blank"
          rel="noopener noreferrer">{t.source}&thinsp;↗</a
        >
      </div>
    </article>

    <article
      class="flex flex-col justify-center border border-hairline border-dashed p-8 md:p-10"
      data-reveal
    >
      <p class="micro text-xs text-muted">{t.nextLabel}</p>
      <h3 class="mt-4 text-lg font-medium">{t.nextTitle}</h3>
      <p class="mt-3 text-sm leading-relaxed text-muted">
        {t.nextBody}
      </p>
    </article>
  </div>
</section>
