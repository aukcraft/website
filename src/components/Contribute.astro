---
import SectionHeading from './SectionHeading.astro';
import FlightLine from './FlightLine.astro';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const roles = [
  {
    n: '01',
    title: zh ? 'SDD 开发者' : 'SDD developers',
    body: zh
      ? '规格驱动开发：把规格与意图变成可运行的系统。'
      : 'Spec-driven development: turning specs and intent into working systems.',
  },
  {
    n: '02',
    title: zh ? '全栈工程师' : 'Full-stack engineers',
    body: zh
      ? 'AI 时代的全栈：从 prompt 到产品，从前端到后端。'
      : 'Full-stack in the AI era: from prompt to product, frontend to backend.',
  },
  {
    n: '03',
    title: zh ? 'AI 工程师' : 'AI engineers',
    body: zh
      ? '智能体、工具链、评估与工作流集成。'
      : 'Agents, tooling, evaluation, and workflow integration.',
  },
  {
    n: '04',
    title: zh ? '设计师' : 'Designers',
    body: zh
      ? '工具类产品设计，关注交互细节与视觉克制。'
      : 'Tool-product design, interaction detail, visual restraint.',
  },
];

const t = {
  lead: zh
    ? '我们在寻找同样敬畏手艺的你。'
    : "We're looking for contributors who care about the craft.",
  note: zh
    ? '提交 Issue、发起 PR，或直接邮件联系。'
    : 'Open an Issue, send a PR, or write to us directly.',
};
---

<section id="contribute" class="mx-auto max-w-5xl px-6 py-40 md:py-56">
  <SectionHeading index="05" label={zh ? '参与贡献' : 'CONTRIBUTE'} />

  <p class="mt-16 max-w-prose text-lg leading-relaxed md:text-xl" data-reveal>
    {t.lead}
  </p>

  <div class="mt-12 grid gap-px bg-hairline sm:grid-cols-2">
    {
      roles.map((role) => (
        <article class="glass-deep p-8" data-reveal>
          <p class="micro text-xs text-muted">{role.n}</p>
          <h3 class="mt-3 text-lg font-medium">{role.title}</h3>
          <p class="mt-4 text-sm leading-relaxed">{role.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 flex flex-wrap items-center gap-8" data-reveal>
    <a
      href="mailto:dev@aukcraft.org"
      class="flight inline-flex items-center border border-hairline px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-teal"
    >
      dev@aukcraft.org
      <FlightLine />
    </a>
    <p class="max-w-prose text-sm leading-relaxed text-muted">
      {t.note}
    </p>
  </div>
</section>
