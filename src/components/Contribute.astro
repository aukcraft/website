---
import SectionHeading from './SectionHeading.astro';
import FlightLine from './FlightLine.astro';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const roles = [
  {
    n: '01',
    title: zh ? 'Skills 架构师' : 'Skills architects',
    body: zh
      ? '设计 skill 的能力边界与模块化结构，让技能可组合。'
      : 'Designing skill boundaries and modular structure, so skills compose.',
  },
  {
    n: '02',
    title: zh ? 'Skills 工程师' : 'Skills engineers',
    body: zh
      ? '把 prompt 与工作流沉淀为可复用的技能，从能力到产品。'
      : 'Turning prompts and workflows into reusable skills, from capability to product.',
  },
  {
    n: '03',
    title: zh ? 'Skills 产品设计' : 'Skills product design',
    body: zh
      ? '设计更符合用户直觉的技能产品。'
      : 'Designing skill products that match how users actually think.',
  },
  {
    n: '04',
    title: zh ? 'Skills UI/UX 设计师' : 'Skills UI/UX designers',
    body: zh
      ? '界面与交互设计，关注细节与视觉克制。'
      : 'Interface and interaction design, detail-obsessed, visually restrained.',
  },
];

const t = {
  lead: zh
    ? '我们在寻找同样敬畏手艺的你。'
    : "We're looking for contributors who care about the craft.",
  note: zh
    ? '提交 Issue、发起 PR，或直接邮件联系。'
    : 'Open an Issue, send a PR, or write to us directly.',
};
---

<section id="contribute" class="relative mx-auto max-w-5xl px-6 py-40 md:py-56">
  <SectionHeading index="05" label={zh ? '参与贡献' : 'CONTRIBUTE'} />

  <p class="mt-16 max-w-prose text-lg leading-relaxed md:text-xl" data-reveal>
    {t.lead}
  </p>

  <div class="mt-12 grid gap-px bg-hairline sm:grid-cols-2">
    {
      roles.map((role) => (
        <article class="glass-deep p-8" data-reveal>
          <p class="micro text-xs text-muted">{role.n}</p>
          <h3 class="mt-3 text-lg font-medium">{role.title}</h3>
          <p class="mt-4 text-sm leading-relaxed">{role.body}</p>
        </article>
      ))
    }
  </div>

  <div class="mt-12 flex flex-wrap items-center gap-8" data-reveal>
    <a
      href="mailto:dev@aukcraft.org"
      class="flight inline-flex items-center border border-hairline px-6 py-3 font-mono text-xs uppercase tracking-[0.15em] text-teal"
    >
      dev@aukcraft.org
      <FlightLine />
    </a>
    <p class="max-w-prose text-sm leading-relaxed text-muted">
      {t.note}
    </p>
  </div>
</section>
