---
/**
 * Construction — 尺规作图背景层（无文案，纯背景变化）。
 * 作为 Contribute 板块的绝对定位背景：圆规圆与直尺线依次描画
 * （Flight Line 同款 stroke-dashoffset，零库），随后海鹦淡入落稿。
 * 滚动进入视野触发一次；reduced-motion 直接呈现最终状态。
 * 透过毛玻璃卡片可见，不遮挡正文。
 */
import PuffinMark from './PuffinMark.astro';
---

<div class="construction pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  <PuffinMark class="absolute -right-[8%] top-1/2 h-[125%] w-auto -translate-y-1/2 opacity-[0.16]">
    <g class="construct">
      <!-- 圆规：腹部外弧（A 315,315 的圆心） -->
      <circle cx="433.5" cy="490" r="315" pathLength="1" style="--i:0"></circle>
      <!-- 圆规：眼睛 + 放大参考圆 -->
      <circle cx="673" cy="290" r="54" pathLength="1" style="--i:1"></circle>
      <circle cx="673" cy="290" r="13.5" pathLength="1" style="--i:2"></circle>
      <!-- 直尺：腹部顶边 / 分割线 / 底边 -->
      <line x1="300" y1="462" x2="780" y2="462" pathLength="1" style="--i:3"></line>
      <line x1="300" y1="579" x2="780" y2="579" pathLength="1" style="--i:4"></line>
      <line x1="330" y1="793" x2="540" y2="793" pathLength="1" style="--i:5"></line>
      <!-- 直尺：主翼前缘对角线 -->
      <line x1="594" y1="466" x2="245" y2="772" pathLength="1" style="--i:6"></line>
      <!-- 直尺：喙尖垂线 / 站立基线 -->
      <line x1="836" y1="262" x2="836" y2="368" pathLength="1" style="--i:7"></line>
      <line x1="490" y1="866" x2="660" y2="866" pathLength="1" style="--i:8"></line>
    </g>
  </PuffinMark>
</div>

<script>
  const construction = document.querySelector('.construction');
  if (construction) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            construction.classList.add('is-constructed');
            io.disconnect();
          }
        }
      },
      { threshold: 0.25 }
    );
    io.observe(construction);
  }
</script>
