---
import SectionHeading from './SectionHeading.astro';

interface Props {
  lang?: 'en' | 'zh';
}

const { lang = 'en' } = Astro.props;
const zh = lang === 'zh';

const cards = [
  {
    n: '01',
    title: zh ? '规范驱动开发' : 'Spec-Driven Development',
    body: zh
      ? '先写规格，再写代码——规格是团队与 AI 协作的单一事实来源。'
      : 'Specs before code — the spec is the single source of truth for how our team and AI collaborate.',
  },
  {
    n: '02',
    title: zh ? '模块化即战略' : 'Modularity as strategy',
    body: zh
      ? '每个组件独立、可测试、可复用——今天的内部模块，明天就是开源 crate。'
      : "Every component is independent, testable, and reusable — today's internal module is tomorrow's open-source crate.",
  },
  {
    n: '03',
    title: zh ? '流程即产品' : 'Process is product',
    body: zh
      ? 'CI/CD、代码审查、发布策略与文档，与最终代码同等重要。'
      : 'CI/CD, code review, release strategy, and documentation are as important as the final code.',
  },
  {
    n: '04',
    title: zh ? '性能是底线' : 'Performance as baseline',
    body: zh
      ? '每一帧都有预算；性能不是事后优化，而是设计之初的约束。'
      : 'Every frame has a budget; performance is a design constraint, not an afterthought.',
  },
];
---

<section id="philosophy" class="mx-auto max-w-5xl px-6 py-40 md:py-56">
  <SectionHeading index="01" label={zh ? '理念' : 'PHILOSOPHY'} />

  <div class="mt-16 grid gap-px bg-hairline sm:grid-cols-2">
    {
      cards.map((card) => (
        <article class="glass-deep p-8 md:p-10" data-reveal>
          <p class="micro text-xs text-muted">{card.n}</p>
          <h3 class="mt-4 text-xl font-medium">{card.title}</h3>
          <p class="mt-6 max-w-prose text-sm leading-relaxed">{card.body}</p>
        </article>
      ))
    }
  </div>
</section>
