---
interface Props {
  /** Two-digit section number, e.g. '01' */
  index: string;
  /** Section label, uppercase for display; used verbatim in the heading text */
  label: string;
}

const { index, label } = Astro.props;
---

<h2 class="flex items-center gap-4" data-reveal>
  <span class="micro text-xs text-muted">
    <span aria-hidden="true">{index}&thinsp;─&thinsp;</span><span class="text-ink">{label}</span>
  </span>
  <span class="h-px flex-1 bg-hairline" aria-hidden="true"></span>
</h2>
